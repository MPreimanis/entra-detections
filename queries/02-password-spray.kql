// Password spray
// One IP address failing with wrong passwords across many accounts in a short time, plus any
// account that then signed in successfully from the same address.
// MITRE ATT&CK: T1110.003 Brute Force: Password Spraying
// Data: SigninLogs
// Tuning: adjust minAccounts to the size of the tenant. Exclude your own egress IPs if a misconfigured app causes noise.
// Response: block the IP if it's clearly hostile. For every account that succeeded, revoke sessions and reset the password.
let lookback = 1h;
let minAccounts = 10;
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType == "50126"
| summarize FailedAccounts = dcount(UserPrincipalName), Attempts = count(), Sample = make_set(UserPrincipalName, 10),
    FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by IPAddress
| where FailedAccounts >= minAccounts
| join kind=leftouter (
    SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType == "0"
    | summarize SucceededAccounts = make_set(UserPrincipalName, 10) by IPAddress
  ) on IPAddress
| project IPAddress, FailedAccounts, Attempts, Sample, SucceededAccounts, FirstSeen, LastSeen
| order by FailedAccounts desc
