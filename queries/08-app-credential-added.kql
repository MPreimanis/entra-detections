// New secret or certificate on an application or service principal
// Adding a credential to an app that already has powerful permissions is a common way to keep access
// after a compromise, and it survives password resets.
// MITRE ATT&CK: T1098.001 Account Manipulation: Additional Cloud Credentials
// Data: AuditLogs
// Tuning: your own credential rotations and pipelines will show up; allow-list those actors.
// Response: confirm the change with the app's owner. If nobody expected it, remove the credential and
// review the app's sign-ins.
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName contains "Certificates and secrets management" or OperationName == "Add service principal credentials"
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
| extend Target = tostring(TargetResources[0].displayName)
| project TimeGenerated, OperationName, Actor, Target, Result
| order by TimeGenerated desc
